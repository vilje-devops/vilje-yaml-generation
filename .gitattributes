# Force LF. A workflow YAML with CRLF line endings breaks shell `run:` blocks on Linux
# runners with: $'\r': command not found
*           text=auto eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
